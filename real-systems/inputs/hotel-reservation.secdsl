#attribute Domain = (frontend, account, reservation, attractions, observability, review);
#attribute DataClass = (account);

#context frontendCtx    = (Domain=frontend);
#context reservationCtx = (Domain=reservation);
#context accountDbCtx   = (DataClass=account);

#context viaAccount = (Domain=account);
#property Isolation(accountDbCtx, frontendCtx, viaAccount);
#property Availability(frontendCtx, medium);
#property Availability(reservationCtx, medium);
